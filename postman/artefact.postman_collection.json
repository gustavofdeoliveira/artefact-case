              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 207 or 200 (mixed results)\", () => pm.expect([200, 207]).to.include(pm.response.code));",
                  "const [list, byId] = pm.response.json();",
                  "pm.test(\"first call ok\", () => pm.expect(list.result.data.items).to.be.an(\"array\"));",
                  "pm.test(\"second call fails independently\", () => pm.expect(byId.error.data.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
