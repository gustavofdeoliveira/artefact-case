{
  "info": {
    "name": "artefact – tRPC task API",
    "description": "Black-box tests for the tRPC backend (task.list/byId/create/update/delete).\n\ntRPC over HTTP:\n- query → `GET {{baseUrl}}/<procedure>?input=<JSON>`\n- mutation → `POST {{baseUrl}}/<procedure>` with the JSON input as body\n- success → `{ result: { data } }`; error → `{ error: { message, code, data: { code, httpStatus, zodError } } }`\n\nRun the folders in order (the CRUD folder chains variables). CLI: `npx newman run postman/artefact.postman_collection.json -e postman/local.postman_environment.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 · CRUD happy path",
      "item": [
        {
          "name": "B01 · List first page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json().result.data;",
                  "pm.test(\"at most 10 items\", () => pm.expect(res.items.length).to.be.at.most(10));",
                  "pm.test(\"every item has the case fields\", () => res.items.forEach(t => {",
                  "  pm.expect(t.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/); pm.expect(t.titulo).to.be.a(\"string\").and.not.empty; pm.expect(t.dataCriacao).to.be.a(\"number\");",
                  "}));",
                  "pm.test(\"newest first\", () => { for (let i = 1; i < res.items.length; i++) pm.expect(res.items[i-1].dataCriacao).to.be.at.least(res.items[i].dataCriacao); });",
                  "pm.collectionVariables.set(\"nextCursor\", JSON.stringify(res.nextCursor));",
                  "pm.collectionVariables.set(\"firstPageIds\", JSON.stringify(res.items.map(t => t.id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/task.list?input={\"limit\":10}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task.list"
              ],
              "query": [
                {
                  "key": "input",
                  "value": "{\"limit\":10}"
                }
              ]
            },
            "description": "FR02 – first page, newest first. Stores `nextCursor` for B02."
          }
        },
        {
          "name": "B02 · List next page (cursor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json().result.data;",
                  "const cursor = JSON.parse(pm.collectionVariables.get(\"nextCursor\"));",
                  "const seen = JSON.parse(pm.collectionVariables.get(\"firstPageIds\"));",
                  "pm.test(\"no item repeated from page 1\", () => res.items.forEach(t => pm.expect(seen).to.not.include(t.id)));",
                  "pm.test(\"all items older than cursor\", () => res.items.forEach(t => pm.expect(t.dataCriacao).to.be.at.most(cursor.dataCriacao)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/task.list?input={\"limit\":10,\"cursor\":{{nextCursor}}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task.list"
              ],
              "query": [
                {
                  "key": "input",
                  "value": "{\"limit\":10,\"cursor\":{{nextCursor}}}"
                }
              ]
            },
            "description": "FR02/FR12 – keyset pagination. Requires at least 11 tasks (seed creates 25)."
          }
        },
        {
          "name": "B03 · Create task (title + description)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json().result.data;",
                  "pm.test(\"server generates a UUID id\", () => pm.expect(res.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/));",
                  "pm.test(\"server generates dataCriacao\", () => pm.expect(Math.abs(Date.now() - res.dataCriacao)).to.be.below(60000));",
                  "pm.test(\"title is trimmed\", () => pm.expect(res.titulo).to.match(/^Postman task \\d+$/));",
                  "pm.test(\"description kept\", () => pm.expect(res.descricao).to.eql(\"Created by the Postman collection\"));",
                  "pm.collectionVariables.set(\"taskId\", res.id);",
                  "pm.collectionVariables.set(\"taskCreatedAt\", res.dataCriacao);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"titulo\":\"  Postman task {{$timestamp}}  \",\"descricao\":\"Created by the Postman collection\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/task.create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "task.create"
              ]
            },
            "description": "FR01 – stores `taskId` for the following requests."
          }
        },
